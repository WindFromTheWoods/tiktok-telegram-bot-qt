PROJECT_NAME           = "TikTok Telegram Bot"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Desktop Telegram video publication scheduler"
PROJECT_ICON           =

OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/documentation"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/src" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.dox" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/CODING_STYLE.md"
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp *.dox *.md
EXCLUDE_PATTERNS       = */build/* */tests/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = "@CMAKE_CURRENT_BINARY_DIR@/documentation/doxygen-warnings.log"

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO
QUIET                  = YES
